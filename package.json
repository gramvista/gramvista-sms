{
  "name": "gramvista-sms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:demo": "concurrently -k \"tsx server/dev.ts\" \"vite --mode demo --host 127.0.0.1 --port 5175 --strictPort\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@supabase/supabase-js": "^2.57.0",
